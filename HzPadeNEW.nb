  3.967098410975483*^9}},ExpressionUUID->"d272b808-12d5-4f61-911c-\
bcaa061c28da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"P11", "[", "z_", "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"a0", "+", 
     RowBox[{"a1", " ", "z"}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"b1", " ", "z"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9642121423089466`*^9, 3.96421216300955*^9}, {
  3.9670984138750153`*^9, 3.967098416895424*^9}},
