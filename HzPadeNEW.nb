293dd0d170ac"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HzTaylor3", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{"HtTaylor3", ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0", ",", "3"}], "}"}]}], "]"}], "//", "Simplify"}], 
   "//", "Normal"}]}]], "Input",
 CellChangeTimes->{{3.964211760053196*^9, 3.964211781351755*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"22a83df1-061a-6843-a5b2-07b1606ce490"],

Cell[BoxData[
 RowBox[{"H0", "+", 
  RowBox[{"H0", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "q0"}], ")"}], " ", "z"}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", "H0", " ", 
   RowBox[{"(", 
    RowBox[{"j0", "-", 
     SuperscriptBox["q0", "2"]}], ")"}], " ", 
   SuperscriptBox["z", "2"]}], "-", 
