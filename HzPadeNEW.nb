          SuperscriptBox["a", "\[Prime]",
           MultilineFunction->None], "[", "t0", "]"}], "3"]}], "-", 
       RowBox[{"6", " ", 
        RowBox[{"a", "[", "t0", "]"}], " ", 
        RowBox[{
         SuperscriptBox["a", "\[Prime]",
          MultilineFunction->None], "[", "t0", "]"}], " ", 
        RowBox[{
         SuperscriptBox["a", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "t0", "]"}]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"a", "[", "t0", "]"}], "2"], " ", 
