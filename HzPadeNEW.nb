Cell[BoxData["\<\"1/3 * H0 * ( ( j0 + -1 * ( q0 )**( 2 ) ) )**( -1 ) * ( 6 * \
j0 + ( 7 * j0 * q0 + ( -6 * ( q0 )**( 2 ) + ( -6 * ( q0 )**( 3 ) + s0 ) ) ) )\
\"\>"], "Output",
 CellChangeTimes->{3.964214080914793*^9, 3.9666182498328094`*^9},
