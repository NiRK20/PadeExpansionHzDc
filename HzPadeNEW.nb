  3.9642120912704334`*^9, 3.966618185352194*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"ff31a4c1-d635-1c41-85dd-22ced68b61d2"]
}, Open  ]],

Cell["Calculando coeficientes de P21", "Text",
 CellChangeTimes->{{3.964212133606207*^9, 
  3.9642121381780777`*^9}},ExpressionUUID->"0cb01d27-9be2-e24b-a92f-\
7dec03c6dd18"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"P21", "[", "z_", "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"a0", "+", 
     RowBox[{"a1", " ", "z"}], "+", 
     RowBox[{"a2", " ", 
      RowBox[{"z", "^", "2"}]}]}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"b1", " ", "z"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9642121423089466`*^9, 3.96421216300955*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"eaea4817-b517-0445-8453-638932338671"],

Cell[BoxData[
 FractionBox[
  RowBox[{"a0", "+", 
   RowBox[{"a1", " ", "z"}], "+", 
   RowBox[{"a2", " ", 
    SuperscriptBox["z", "2"]}]}], 
  RowBox[{"1", "+", 
   RowBox[{"b1", " ", "z"}]}]]], "Output",
 CellChangeTimes->{3.9642121661261997`*^9, 3.9666182337264786`*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"bdd92355-7a36-9344-9db2-3e575577dac2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"HzP3", "[", "z_", "]"}], "=", "HzTaylor3"}]], "Input",
 CellChangeTimes->{{3.964212169151335*^9, 3.9642121998204556`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"724880db-11e1-594c-9f68-ff94a95b3c41"],

Cell[BoxData[
 RowBox[{"H0", "+", 
  RowBox[{"H0", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "q0"}], ")"}], " ", "z"}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", "H0", " ", 
   RowBox[{"(", 
    RowBox[{"j0", "-", 
     SuperscriptBox["q0", "2"]}], ")"}], " ", 
   SuperscriptBox["z", "2"]}], "-", 
  RowBox[{
   FractionBox["1", "6"], " ", "H0", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], " ", 
      SuperscriptBox["q0", "2"]}], "-", 
     RowBox[{"3", " ", 
      SuperscriptBox["q0", "3"]}], "+", 
     RowBox[{"j0", " ", 
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{"4", " ", "q0"}]}], ")"}]}], "+", "s0"}], ")"}], " ", 
   SuperscriptBox["z", "3"]}]}]], "Output",
 CellChangeTimes->{3.9642122104571743`*^9, 3.966618236367441*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"f6a3e925-0aef-7845-8d8a-466dc6ec6117"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eqhzP21", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"HzP3", "[", "z", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "i"}], "}"}]}], "]"}], "==", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"P21", "[", "z", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "i"}], "}"}]}], "]"}]}], ")"}], "/.", 
     RowBox[{"z", "->", "0"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "3"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9642122413712425`*^9, 3.964212280816761*^9}, {
  3.964212334110985*^9, 3.9642123726316776`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"2741e296-43ab-714f-af09-bce88bed15ef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"H0", "\[Equal]", "a0"}], ",", 
   RowBox[{
    RowBox[{"H0", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "q0"}], ")"}]}], "\[Equal]", 
    RowBox[{"a1", "-", 
     RowBox[{"a0", " ", "b1"}]}]}], ",", 
   RowBox[{
    RowBox[{"H0", " ", 
     RowBox[{"(", 
      RowBox[{"j0", "-", 
       SuperscriptBox["q0", "2"]}], ")"}]}], "\[Equal]", 
    RowBox[{
     RowBox[{"2", " ", "a2"}], "-", 
     RowBox[{"2", " ", "a1", " ", "b1"}], "+", 
     RowBox[{"2", " ", "a0", " ", 
      SuperscriptBox["b1", "2"]}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "H0"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "3"}], " ", 
        SuperscriptBox["q0", "2"]}], "-", 
       RowBox[{"3", " ", 
        SuperscriptBox["q0", "3"]}], "+", 
       RowBox[{"j0", " ", 
        RowBox[{"(", 
         RowBox[{"3", "+", 
          RowBox[{"4", " ", "q0"}]}], ")"}]}], "+", "s0"}], ")"}]}], "\[Equal]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "6"}], " ", "a2", " ", "b1"}], "+", 
     RowBox[{"6", " ", "a1", " ", 
      SuperscriptBox["b1", "2"]}], "-", 
     RowBox[{"6", " ", "a0", " ", 
      SuperscriptBox["b1", "3"]}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.964212375361162*^9, 3.9666182409966927`*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"12fc5eb5-8b9e-134f-92eb-016a50b77404"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"solhzP21", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{"eqhzP21", ",", " ", 
    RowBox[{"{", 
     RowBox[{"a0", ",", "a1", ",", "a2", ",", "b1"}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9642123792385426`*^9, 3.9642123997910824`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"b258fe88-4d3d-e842-84d5-065672163e61"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a0", "\[Rule]", "H0"}], ",", 
    RowBox[{"a1", "\[Rule]", 
     FractionBox[
      RowBox[{"H0", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"6", " ", "j0"}], "+", 
         RowBox[{"7", " ", "j0", " ", "q0"}], "-", 
         RowBox[{"6", " ", 
          SuperscriptBox["q0", "2"]}], "-", 
         RowBox[{"6", " ", 
          SuperscriptBox["q0", "3"]}], "+", "s0"}], ")"}]}], 
      RowBox[{"3", " ", 
       RowBox[{"(", 
        RowBox[{"j0", "-", 
         SuperscriptBox["q0", "2"]}], ")"}]}]]}], ",", 
    RowBox[{"a2", "\[Rule]", 
     FractionBox[
      RowBox[{"H0", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"6", " ", "j0"}], "+", 
         RowBox[{"3", " ", 
          SuperscriptBox["j0", "2"]}], "+", 
         RowBox[{"14", " ", "j0", " ", "q0"}], "-", 
         RowBox[{"6", " ", 
          SuperscriptBox["q0", "2"]}], "+", 
         RowBox[{"2", " ", "j0", " ", 
          SuperscriptBox["q0", "2"]}], "-", 
         RowBox[{"12", " ", 
          SuperscriptBox["q0", "3"]}], "-", 
         RowBox[{"3", " ", 
          SuperscriptBox["q0", "4"]}], "+", 
         RowBox[{"2", " ", "s0"}], "+", 
         RowBox[{"2", " ", "q0", " ", "s0"}]}], ")"}]}], 
      RowBox[{"6", " ", 
       RowBox[{"(", 
        RowBox[{"j0", "-", 
         SuperscriptBox["q0", "2"]}], ")"}]}]]}], ",", 
    RowBox[{"b1", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"3", " ", "j0"}], "+", 
       RowBox[{"4", " ", "j0", " ", "q0"}], "-", 
       RowBox[{"3", " ", 
        SuperscriptBox["q0", "2"]}], "-", 
       RowBox[{"3", " ", 
        SuperscriptBox["q0", "3"]}], "+", "s0"}], 
      RowBox[{"3", " ", 
       RowBox[{"(", 
        RowBox[{"j0", "-", 
         SuperscriptBox["q0", "2"]}], ")"}]}]]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9642124018763657`*^9, 3.9666182424218674`*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"44b1f5ea-0015-1c48-91a0-33adff3384b1"]
}, Open  ]],

