  RowBox[{"1", "+", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["a", "\[Prime]",
       MultilineFunction->None], "[", "t0", "]"}], " ", "tl"}], 
    RowBox[{"a", "[", "t0", "]"}]], "+", 
