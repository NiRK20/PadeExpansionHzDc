    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], " ", 
      SuperscriptBox["q0", "2"]}], "-", 
     RowBox[{"3", " ", 
      SuperscriptBox["q0", "3"]}], "+", 
     RowBox[{"j0", " ", 
      RowBox[{"(", 
       RowBox[{"3", "+", 
        RowBox[{"4", " ", "q0"}]}], ")"}]}], "+", "s0"}], ")"}], " ", 
   SuperscriptBox["z", "3"]}]}]], "Output",
