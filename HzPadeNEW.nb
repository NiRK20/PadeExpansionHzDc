Cell[BoxData[
 RowBox[{"H0", "+", 
  RowBox[{"H0", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "q0"}], ")"}], " ", "z"}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", "H0", " ", 
   RowBox[{"(", 
    RowBox[{"j0", "-", 
     SuperscriptBox["q0", "2"]}], ")"}], " ", 
   SuperscriptBox["z", "2"]}]}]], "Output",
