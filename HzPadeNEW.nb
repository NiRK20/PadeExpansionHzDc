}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HtTaylor3", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Ht1Taylor4", "//", "Normal"}], ")"}], "/.", 
     RowBox[{"tl", "->", "tlTaylor4"}]}], ")"}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.9642117944141808`*^9, 3.964211838387476*^9}, {
  3.9666181470660133`*^9, 3.9666181773113117`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"ca12750a-9a1a-b54f-be48-deb142e080df"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"H0", "+", 
   RowBox[{"H0", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "q0"}], ")"}], " ", "z"}], "+", 
   RowBox[{
    FractionBox["1", "2"], " ", "H0", " ", 
    RowBox[{"(", 
     RowBox[{"j0", "-", 
      SuperscriptBox["q0", "2"]}], ")"}], " ", 
    SuperscriptBox["z", "2"]}], "-", 
   RowBox[{
    FractionBox["1", "6"], " ", 
    RowBox[{"(", 
     RowBox[{"H0", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], " ", 
         SuperscriptBox["q0", "2"]}], "-", 
        RowBox[{"3", " ", 
         SuperscriptBox["q0", "3"]}], "+", 
        RowBox[{"j0", " ", 
         RowBox[{"(", 
          RowBox[{"3", "+", 
           RowBox[{"4", " ", "q0"}]}], ")"}]}], "+", "s0"}], ")"}]}], ")"}], " ", 
    SuperscriptBox["z", "3"]}], "-", 
   RowBox[{
    FractionBox["1", "24"], " ", 
    RowBox[{"(", 
     RowBox[{"H0", " ", 
      RowBox[{"(", 
       RowBox[{"24", "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["j0", "2"]}], "+", 
        RowBox[{"42", " ", 
         SuperscriptBox["q0", "2"]}], "+", 
        RowBox[{"24", " ", 
         SuperscriptBox["q0", "3"]}], "+", 
        RowBox[{"15", " ", 
         SuperscriptBox["q0", "4"]}], "+", 
        RowBox[{"j0", " ", 
         RowBox[{"(", 
          RowBox[{"8", "-", 
           RowBox[{"22", " ", "q0"}], "-", 
           RowBox[{"25", " ", 
            SuperscriptBox["q0", "2"]}]}], ")"}]}], "+", 
        RowBox[{"q0", " ", 
         RowBox[{"(", 
          RowBox[{"60", "-", 
           RowBox[{"7", " ", "s0"}]}], ")"}]}], "-", 
        RowBox[{"13", " ", "s0"}]}], ")"}]}], ")"}], " ", 
    SuperscriptBox["z", "4"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "z", "]"}], "5"],
    SeriesData[$CellContext`z, 0, {}, 0, 5, 1],
    Editable->False]}],
  SeriesData[$CellContext`z, 
   0, {$CellContext`H0, $CellContext`H0 (1 + $CellContext`q0), 
    Rational[1, 2] $CellContext`H0 ($CellContext`j0 - $CellContext`q0^2), 
    Rational[-1, 6] $CellContext`H0 ((-3) $CellContext`q0^2 - 
     3 $CellContext`q0^3 + $CellContext`j0 (3 + 
       4 $CellContext`q0) + $CellContext`s0), 
    Rational[-1, 24] $CellContext`H0 (24 + 4 $CellContext`j0^2 + 
     42 $CellContext`q0^2 + 24 $CellContext`q0^3 + 
     15 $CellContext`q0^4 + $CellContext`j0 (8 - 22 $CellContext`q0 - 
       25 $CellContext`q0^2) + $CellContext`q0 (60 - 7 $CellContext`s0) - 
     13 $CellContext`s0)}, 0, 5, 1],
  Editable->False]], "Output",
 CellChangeTimes->{
  3.964211839023718*^9, 3.964211977179796*^9, 3.964212086314106*^9, {
   3.9666181537502537`*^9, 3.966618178342022*^9}},
 CellLabel->"Out[13]=",ExpressionUUID->"7b6628e5-f8bf-7f42-a0ea-26b118fb0987"]
}, Open  ]],

Cell["Reescrevendo a expans\[ATilde]o H(t) como uma expans\[ATilde]o de \
