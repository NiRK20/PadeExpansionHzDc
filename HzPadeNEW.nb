}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eqhzP11", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"HzP2", "[", "z", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "i"}], "}"}]}], "]"}], "==", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"P11", "[", "z", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "i"}], "}"}]}], "]"}]}], ")"}], "/.", 
     RowBox[{"z", "->", "0"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "2"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9642122413712425`*^9, 3.964212280816761*^9}, {
  3.964212334110985*^9, 3.9642123726316776`*^9}, {3.967098462152145*^9, 
  3.9670984728551893`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"aef5b065-585f-40b1-b21f-05dc3e1e41cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"H0", "\[Equal]", "a0"}], ",", 
   RowBox[{
    RowBox[{"H0", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "q0"}], ")"}]}], "\[Equal]", 
    RowBox[{"a1", "-", 
     RowBox[{"a0", " ", "b1"}]}]}], ",", 
   RowBox[{
    RowBox[{"H0", " ", 
     RowBox[{"(", 
      RowBox[{"j0", "-", 
       SuperscriptBox["q0", "2"]}], ")"}]}], "\[Equal]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", "a1", " ", "b1"}], "+", 
     RowBox[{"2", " ", "a0", " ", 
      SuperscriptBox["b1", "2"]}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.964212375361162*^9, 3.9666182409966927`*^9, 
  3.967098474638567*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"414659d8-6ab0-4177-affa-7165cc755be4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"solhzP11", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{"eqhzP11", ",", " ", 
    RowBox[{"{", 
     RowBox[{"a0", ",", "a1", ",", "b1"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9642123792385426`*^9, 3.9642123997910824`*^9}, {
  3.9670984866548023`*^9, 3.967098491253137*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"a02a1f63-a7c4-4171-a607-4bf8f5716f75"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a0", "\[Rule]", "H0"}], ",", 
    RowBox[{"a1", "\[Rule]", 
     FractionBox[
      RowBox[{"H0", " ", 
       RowBox[{"(", 
        RowBox[{"2", "-", "j0", "+", 
         RowBox[{"4", " ", "q0"}], "+", 
         RowBox[{"3", " ", 
          SuperscriptBox["q0", "2"]}]}], ")"}]}], 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "q0"}], ")"}]}]]}], ",", 
    RowBox[{"b1", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"-", "j0"}], "+", 
       SuperscriptBox["q0", "2"]}], 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "q0"}], ")"}]}]]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9642124018763657`*^9, 3.9666182424218674`*^9, 
  3.9670984920286217`*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"d74a2c55-7335-40c8-b9b7-7c262cc48f50"]
}, Open  ]],

