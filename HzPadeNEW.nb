        RowBox[{
         SuperscriptBox["a", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "t0", "]"}]}]}], ")"}], " ", 
     SuperscriptBox["tl", "2"]}], 
    RowBox[{"2", " ", 
     SuperscriptBox[
      RowBox[{"a", "[", "t0", "]"}], "2"]}]], "+", 
