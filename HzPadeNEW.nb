Cell[BoxData["\<\"1/6 * H0 * ( ( j0 + -1 * ( q0 )**( 2 ) ) )**( -1 ) * ( 6 * \
j0 + ( 3 * ( j0 )**( 2 ) + ( 14 * j0 * q0 + ( -6 * ( q0 )**( 2 ) + ( 2 * j0 * \
( q0 )**( 2 ) + ( -12 * ( q0 )**( 3 ) + ( -3 * ( q0 )**( 4 ) + ( 2 * s0 + 2 * \
q0 * s0 ) ) ) ) ) ) ) )\"\>"], "Output",
 CellChangeTimes->{3.964214080914793*^9, 3.9666182498667717`*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"f07009a7-7910-624e-8399-e74aaef10bca"],

Cell[BoxData["\<\"1/3 * ( ( j0 + -1 * ( q0 )**( 2 ) ) )**( -1 ) * ( 3 * j0 + \
( 4 * j0 * q0 + ( -3 * ( q0 )**( 2 ) + ( -3 * ( q0 )**( 3 ) + s0 ) ) ) \
)\"\>"], "Output",
 CellChangeTimes->{3.964214080914793*^9, 3.9666182498997517`*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"5a1cbdee-f76b-384e-bf1d-594facb7e860"]
}, Open  ]],

