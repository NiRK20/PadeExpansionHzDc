412355d8a910"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Hz1P31", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"P31", "[", "z", "]"}], ",", " ", 
      RowBox[{"{", "z", "}"}]}], "]"}], "/.", 
    RowBox[{"a0", "->", "0"}]}], "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.970236180853486*^9, 3.970236195987521*^9}, {
  3.970236236868307*^9, 3.970236249520234*^9}, {3.970236310569874*^9, 
