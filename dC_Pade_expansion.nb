 CellLabel->"In[34]:=",ExpressionUUID->"66f0f266-3490-4536-85b6-5193af49a8cb"],

Cell[BoxData[
 FractionBox[
  RowBox[{"a1", "-", 
   RowBox[{"a1", " ", "b2", " ", 
    SuperscriptBox["z", "2"]}], "+", 
   RowBox[{"z", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"a2", " ", 
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"b1", " ", "z"}]}], ")"}]}], "+", 
      RowBox[{"a3", " ", "z", " ", 
       RowBox[{"(", 
        RowBox[{"3", "+", 
         RowBox[{"2", " ", "b1", " ", "z"}], "+", 
         RowBox[{"b2", " ", 
          SuperscriptBox["z", "2"]}]}], ")"}]}]}], ")"}]}]}], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"b1", " ", "z"}], "+", 
     RowBox[{"b2", " ", 
      SuperscriptBox["z", "2"]}]}], ")"}], "2"]]], "Output",
 CellChangeTimes->{3.970236341815641*^9, 3.972575106301792*^9},
 CellLabel->"Out[34]=",ExpressionUUID->"d6f6dcc8-7f45-4391-b772-2342caab375e"]
}, Open  ]],

